NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Feedback preparation: server-only, no real values in source control.
# Verify these against the existing Access application before approved activation.
FEEDBACK_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
FEEDBACK_ACCESS_AUDIENCE=YOUR_EXISTING_APPLICATION_AUD_TAG
FEEDBACK_OWNER_SUBJECT=YOUR_VERIFIED_OWNER_ACCESS_SUBJECT
FEEDBACK_SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Owner feedback alerts: existing Resend provider, server-only configuration.
# Keep disabled until migration, verified sender and owner destination are approved.
FEEDBACK_NOTIFICATIONS_ENABLED=false
FEEDBACK_NOTIFICATION_TO=owner@example.invalid
FEEDBACK_NOTIFICATION_FROM=notifications@YOUR_VERIFIED_SENDING_DOMAIN
FEEDBACK_NOTIFICATION_INBOX_URL=https://YOUR_PROTECTED_APP/owner/feedback
FEEDBACK_RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_SENDING_KEY
