{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diamond-alibi-preview",
  "main": "custom-worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://twfyeoywjexxnhnluomv.supabase.co",
    "FEEDBACK_NOTIFICATION_FROM": "notifications@mail.eydrenworks.com",
    "FEEDBACK_NOTIFICATION_INBOX_URL": "https://diamondalibi.eydrenworks.com/owner/feedback",
    "FEEDBACK_NOTIFICATIONS_ENABLED": "true",
    "ROAST_CLUB_ENABLED": "true",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "diamond-alibi-preview" },
  ],
}
